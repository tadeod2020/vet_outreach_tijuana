# Copia este archivo a .env y completa tus datos:  cp .env.example .env

# --- Gemini ---
GEMINI_API_KEY=pega_aqui_tu_api_key
# Modelo principal (el mejor disponible) y respaldo rápido si se agota la cuota.
# Para ver los modelos de tu key: python -c "from google import genai; [print(m.name) for m in genai.Client().models.list()]"
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

# --- Remitente / firma ---
REMITENTE_NOMBRE=Tu Nombre
REMITENTE_CARGO=Desarrollador
EMPRESA=Tu Empresa
NOMBRE_SOFTWARE=VetSoft
REMITENTE_TELEFONO=664 000 0000
REMITENTE_SITIO=https://tusitio.com
# Solo si la veterinaria cliente te dio permiso de mencionarla (si no, déjalo vacío):
CLIENTE_REFERENCIA=

# --- Límites ---
MAX_RESULTADOS_POR_ZONA=20
LIMITE_BORRADORES=10
